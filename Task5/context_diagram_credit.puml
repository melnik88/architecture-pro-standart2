@startuml context_diagram_credit
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_LEFT_RIGHT()

title Контекстная диаграмма C4 - Онлайн-подача заявок на кредит

Person(client, "Клиент", "Новый или существующий клиент банка, подающий заявку на кредит онлайн")

Person(call_center_manager, "Менеджер кол-центра", "Звонит клиентам с одобренными заявками для назначения встречи")
Person(front_office_manager, "Менеджер фронт-офиса", "Проводит идентификацию и выдает кредиты в отделении")
Person(credit_manager, "Менеджер бэк-офиса кредитов", "Обрабатывает одобренные заявки в кредитном конвейере")
System(banking_system, "Банковская система 'Стандарт'", "Обеспечивает подачу и обработку кредитных заявок через цифровые каналы с автоматическим скорингом, предодобренными предложениями и выдачей кредитов")
System_Ext(credit_bureau, "Бюро кредитных историй", "Предоставляет кредитные истории клиентов для скоринга")
System_Ext(sms_gateway, "СМС-шлюз телеком-оператора", "Отправка СМС-уведомлений клиентам")

Rel(client, banking_system, "Подает заявку на кредит", "HTTPS/Веб-сайт, Интернет-банк")
Rel(banking_system, credit_bureau, "Запрашивает кредитные истории для скоринга", "REST API")
Rel(banking_system, sms_gateway, "Отправляет запросы на СМС-уведомления")
Rel(sms_gateway, client, "СМС о решении по заявке (одобрено/отказано/принято в обработку)", "SMS")
Rel_U(banking_system, call_center_manager, "Уведомляет о новых одобренных заявках")
Rel_U(call_center_manager, client, "Звонит для назначения встречи в отделении", "Телефонный звонок")
Rel(banking_system, credit_manager, "Передает одобренные заявки на обработку в кредитном конвейере")
Rel(credit_manager, banking_system, "Обрабатывает заявки, формирует договоры, оформляет выдачу в АБС")
Rel(client, front_office_manager, "Приходит для идентификации, подписания договора и получения кредита", "Личная встреча")
Rel(front_office_manager, banking_system, "Проводит идентификацию и оформляет выдачу кредита в АБС")

@enduml
